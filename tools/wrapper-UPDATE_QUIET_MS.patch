diff --git a/wrapper/vst2_wrap.c b/wrapper/vst2_wrap.c
index a700627..fce2300 100644
--- a/wrapper/vst2_wrap.c
+++ b/wrapper/vst2_wrap.c
@@ -48,6 +48,12 @@
 #if SAMPLE_ACCURATE && defined(PLUG_EFFECT)
 #error "SAMPLE_ACCURATE is for instruments: an effect has no notes to place"
 #endif
+#ifndef UPDATE_QUIET_MS
+#define UPDATE_QUIET_MS 0   /* >0: hold UpdateDisplay back while the host is still setting params (a Q-Link being turned), up to
+                             * 1 s, so a turn that changes readouts / list tiles doesn't make MPC rebuild its screen on every
+                             * click (each rebuild redraws the Q-Link screens and drops the knob's place; mpc-vst-m-one 2026-11-14) */
+#endif
+static double wr_now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec + t.tv_nsec * 1e-9; }
 #ifdef WRAP_TRACE   /* poc/inputprobe: the port provides wrap_trace() and logs every raw host call (kind 0 = setParameter, 1 = getParameter) */
 void wrap_trace(int kind, int idx, float value);
 #define TRACE(kind, idx, value) wrap_trace(kind, idx, value)
@@ -159,6 +165,7 @@ typedef struct {
     volatile char cc_changed[NPARAMS];   /* set from MIDI CC/NRPN, reported to the host at most every 1024 frames */
     int cc_report;           /* frames until CC-driven changes are reported again */
     int update_wait;         /* frames until another audioMasterUpdateDisplay may be sent (see housekeeping) */
+    double last_host_set, need_since;   /* UPDATE_QUIET_MS: when the host last set a param / an UpdateDisplay was first wanted */
     int program;             /* NPRESETS: the preset last picked (not in the engine's state; 0 after a reload) */
     void *spage;             /* SAMPLE_PAGE: the page on the MPC Sample's screen (sample_page.h), or NULL */
 #ifdef SAMPLE_PAGE
@@ -270,6 +277,7 @@ static float settle(float pos, float cur, float last) {
 static void set_param_now(AEffect *e, int32_t i, float n) {
     wrap_t *w = e->object;
     TRACE(0, i, n);
+    if (UPDATE_QUIET_MS) w->last_host_set = wr_now();
     char buf[64];
     if (i < 0 || i >= NPARAMS) return;
     const param_t *p = &PARAMS[i];
@@ -644,8 +652,15 @@ static void housekeeping(AEffect *e, int32_t n) {
     /* At most one UpdateDisplay per 50 ms (2205 frames); a request inside that window waits, it is not dropped. MPC rebuilds its
      * parameter screen on each one, so a burst (a held stepper, readouts that change every poll) must not become a rebuild per block. */
     if (w->update_wait > 0) w->update_wait -= n;
-    if (w->need_update_display && w->update_wait <= 0) {
+    int quiet_hold = 0;
+    if (UPDATE_QUIET_MS && w->need_update_display && w->update_wait <= 0) {
+        const double t = wr_now();
+        if (w->need_since == 0) w->need_since = t;
+        if (t - w->last_host_set < UPDATE_QUIET_MS / 1000.0 && t - w->need_since < 1.0) quiet_hold = 1;
+    }
+    if (w->need_update_display && w->update_wait <= 0 && !quiet_hold) {
         w->need_update_display = 0;
+        w->need_since = 0;
         w->update_wait = 2205;
         w->master(&w->fx, audioMasterUpdateDisplay, 0, 0, 0, 0.0f);
     }
